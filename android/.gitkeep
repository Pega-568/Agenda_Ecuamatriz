# android/.gitkeep
# Directorio reservado para la app Android (Fase 7).
#
# Stack planificado:
#   - Kotlin + Jetpack Compose
#   - Retrofit/OkHttp (cliente HTTP)
#   - Room (caché local)
#   - Firebase Cloud Messaging (notificaciones push)
#   - CameraX + ML Kit / ZXing (escaneo QR)
#
# Estructura esperada en Fase 7:
#   android/
#     app/
#       src/main/java/com/ecuamatriz/agenda/
#         api/           — Retrofit services
#         dto/           — Data Transfer Objects
#         repository/    — Repositorios
#         local/         — Room DB
#         viewmodel/     — ViewModels por pantalla
#         screens/       — Composable screens
#         components/    — Composable components reutilizables
#         navigation/    — NavGraph
#         utils/
#     build.gradle.kts
