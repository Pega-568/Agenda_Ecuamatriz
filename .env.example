# ============================================================
# .env.example — Agenda Ecuamatriz
# ============================================================
# INSTRUCCIONES:
#   1. Copiar este archivo como .env en la raíz del proyecto.
#   2. Rellenar cada variable con los valores reales de tu entorno.
#   3. NUNCA commitear el archivo .env (está en .gitignore).
#   4. NUNCA poner secretos reales en este archivo.
#
# Última revisión: Cierre Fase 0
# ============================================================

# ─── Flask ──────────────────────────────────────────────────
FLASK_APP=run.py
# Valores válidos: development | testing | production
FLASK_ENV=development
FLASK_DEBUG=1

# ─── Claves secretas ────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIAR_POR_CLAVE_SECRETA_ALEATORIA_32_BYTES

# ─── Base de datos — PostgreSQL (Docker) ────────────────────
# Usar psycopg (v3) como driver.
# El servidor Docker se define en docker-compose.yml.
DATABASE_URL=postgresql+psycopg://agenda_user:agenda_password@127.0.0.1:5432/agenda_ecuamatriz

# Base de datos exclusiva para pytest (PostgreSQL, no SQLite)
TEST_DATABASE_URL=postgresql+psycopg://agenda_user:agenda_password@127.0.0.1:5432/agenda_ecuamatriz_test

# ─── Autenticación WEB — Flask-Login (sesiones servidor) ────
# La web Jinja2 usa sesiones seguras del lado servidor.
# NO usa JWT para las vistas web.
SESSION_COOKIE_SECURE=False
# En producción: SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
# Tiempo de vida de la sesión en segundos (default: 8 horas)
PERMANENT_SESSION_LIFETIME=28800

# ─── Autenticación API MÓVIL — JWT (Android futuro) ─────────
# Los endpoints /api/ para la app Android usarán JWT.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CAMBIAR_POR_CLAVE_JWT_ALEATORIA_32_BYTES
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# ─── CSRF (Flask-WTF) ────────────────────────────────────────
# Protección CSRF para formularios Jinja2.
# Desactivar solo en tests controlados.
WTF_CSRF_ENABLED=True

# ─── QR de asistencia ────────────────────────────────────────
# Minutos antes del inicio de la reunión en que el QR es válido
QR_DEFAULT_VALID_BEFORE_MINUTES=15
# Minutos después del fin de la reunión en que el QR sigue siendo válido
QR_DEFAULT_VALID_AFTER_MINUTES=30
# Directorio donde se almacenan QR generados (relativo a backend/)
QR_OUTPUT_DIR=app/attendance/generated_qr

# ─── Reportes Excel ──────────────────────────────────────────
REPORTS_OUTPUT_DIR=app/reports/exports

# ─── Correo / Notificaciones SMTP ────────────────────────────
# Desactivar en desarrollo para evitar envíos reales
MAIL_ENABLED=False
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=CAMBIAR_POR_CORREO
MAIL_PASSWORD=CAMBIAR_POR_PASSWORD_CORREO
MAIL_DEFAULT_SENDER=notificaciones@ecuamatriz.com

# ─── Firebase Cloud Messaging (FCM) ──────────────────────────────────────────
FCM_ENABLED=false
FIREBASE_CREDENTIALS_PATH=firebase-adminsdk.json
# Obtener desde consola Firebase > Configuración del proyecto
FCM_SERVER_KEY=CAMBIAR_POR_SERVER_KEY_FCM

# ─── CORS (solo para endpoints /api/ — app Android) ──────────
# La web Jinja2 no necesita CORS (mismo origen).
CORS_ORIGINS=http://localhost:5000

# ─── Aplicación ──────────────────────────────────────────────
APP_NAME=Agenda Ecuamatriz
APP_URL=http://localhost:5000

# ─── Grabaciones (módulo futuro — Fase 8) ────────────────────
# NO implementado. Reservado para integración con código externo.
# RECORDINGS_STORAGE_DIR=uploads/recordings
# RECORDINGS_PROVIDER=local
# TRANSCRIPTION_PROVIDER=pending
# TRANSCRIPTION_API_KEY=PENDIENTE
