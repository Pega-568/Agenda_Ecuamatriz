# ============================================================
# .gitignore — Agenda Ecuamatriz
# ============================================================
# Generado para stack: Python/Flask + Web (Jinja2) + Android (Kotlin)
# NUNCA commitear secretos, tokens, ni archivos generados pesados.
# ============================================================

# ─── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# Entornos virtuales
venv/
.venv/
ENV/
env/
.env/
env.bak/
venv.bak/

# ─── Variables de entorno / secretos ────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.jks
secrets/

# ─── Flask / SQLAlchemy ─────────────────────────────────────
instance/
*.db
*.sqlite
*.sqlite3

# ─── Migraciones auto-generadas temporales ──────────────────
# (NO ignorar la carpeta migrations/ completa, solo archivos de trabajo)
migrations/versions/__pycache__/

# ─── Testing ────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
*.cover
coverage.xml
*.hypothesis/

# ─── Logs ───────────────────────────────────────────────────
*.log
logs/
*.log.*

# ─── Archivos generados por el sistema ──────────────────────
# QR codes generados
backend/app/attendance/generated_qr/
# Reportes Excel exportados
backend/app/reports/exports/
# Archivos de grabación de audio
backend/uploads/recordings/

# ─── Editores e IDEs ────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ─── Node / Web frontend futuro ─────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
.yarn/

# ─── Android ────────────────────────────────────────────────
android/.gradle/
android/local.properties
android/app/build/
android/build/
android/captures/
android/.navigation/
android/lint.xml
android/**/*.apk
android/**/*.aab
android/**/*.ap_
android/**/*.dex
android/**/*.class
android/**/*.jar
android/app/src/main/assets/google-services.json
android/google-services.json
android/app/google-services.json

# ─── Archivos pesados / binarios ────────────────────────────
*.zip
stitch_*.zip
*.tar.gz
*.rar
*.7z
*.html
*.mp3
*.mp4
*.wav
*.ogg
*.mkv
*.avi
*.mov
*.pdf
*.docx
*.xlsx

# ─── Alembic / Flask-Migrate temporal ───────────────────────
*.pyc

# ─── Docker ──────────────────────────────────────────────────
# No ignorar docker-compose.yml (está versionado)
# Solo ignorar datos generados por el contenedor fuera del volumen
.docker/

# ─── Temporales de tests ─────────────────────────────────────
backend/tests/tmp/
.pytest_cache/
